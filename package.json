{
  "name": "sym",
  "version": "0.0.0",
  "private": true,
  "description": "Sym — an AI teammate that lives in a Slack workspace.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint && prettier --check .",
    "lint:fix": "turbo run lint -- --fix && prettier --write .",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "manifest:render": "node scripts/render-manifest.js",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amitray007/sym"
  },
  "author": "Amit Ray",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "knip": "^6.15.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.2",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
