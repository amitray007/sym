{
  "name": "sym",
  "version": "0.0.0",
  "private": true,
  "description": "Sym — an AI teammate that lives in a Slack workspace.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint && prettier --check .",
    "lint:fix": "turbo run lint -- --fix && prettier --write .",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "manifest:render": "node scripts/render-manifest.js",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amitray007/sym"
  },
  "author": "Amit Ray",
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3"
  }
}
