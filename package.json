{
  "name": "sym",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted Slack agent that hands work to coding agents and reports back only what matters.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "build:compile": "eve build --skip-sandbox-prewarm",
    "start": "eve start",
    "db:up": "POSTGRES_PASSWORD=sym docker compose up -d --wait postgres",
    "db:down": "POSTGRES_PASSWORD=sym docker compose down",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "t3:login": "node --env-file-if-exists=.env.local scripts/t3-login.ts",
    "t3:check": "node --env-file-if-exists=.env.local scripts/t3-check.ts",
    "t3:job-smoke": "node --env-file-if-exists=.env.local scripts/t3-job-smoke.ts",
    "eval": "SYM_PROJECTS=example-app node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js eval --exclude-tag=persona --exclude-tag=code-channels",
    "eval:code-channels": "SYM_PROJECTS=example-app SYM_CODE_CHANNELS=on node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js eval --tag=code-channels",
    "eval:plain": "SYM_PROJECTS=example-app SYM_PERSONA=plain node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js eval --tag=persona-plain",
    "eval:spicy": "SYM_PROJECTS=example-app SYM_PERSONA=spicy node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js eval --tag=persona-spicy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@chat-adapter/slack": "4.44.0",
    "@json-render/chat": "0.22.0",
    "@json-render/core": "0.22.0",
    "@modelcontextprotocol/client": "2.3.1",
    "ai": "^7.0.137",
    "chat": "4.44.0",
    "eve": "0.88.0",
    "postgres": "3.4.9",
    "yaml": "2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.84",
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^24.19.2",
    "just-bash": "3.6.0",
    "knip": "^6.42.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
