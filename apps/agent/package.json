{
  "name": "@sym/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "sym": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.config.integration.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "sym": "tsx src/cli/index.ts",
    "qa:mcp": "pnpm --filter @sym/mcp-runtime build && tsc -p tsconfig.json && node scripts/qa-connector.mjs",
    "qa:delete": "tsc -p tsconfig.json && node scripts/qa-delete.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@earendil-works/pi-agent-core": "0.79.4",
    "@earendil-works/pi-ai": "0.79.4",
    "@hono/node-server": "^2.0.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@sym/adapter-slack": "workspace:*",
    "@sym/contracts": "workspace:*",
    "@sym/kernel": "workspace:*",
    "@sym/mcp-runtime": "workspace:*",
    "dotenv": "^17.4.2",
    "hono": "^4.12.25",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "vitest": "catalog:"
  }
}
