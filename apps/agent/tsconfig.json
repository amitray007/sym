{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    // The `sym` TUI is React (Ink). react-jsx = automatic runtime; @types/react
    // references DOM lib types, so DOM is added for type resolution only (no
    // server code uses the browser globals).
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
