# Sym environment — copy to .env and fill in values. NEVER commit .env.

# ── Slack ─────────────────────────────────────────────────────────────────────
# From your Slack app's "Basic Information" page.
SLACK_SIGNING_SECRET=
# Bot token from "OAuth & Permissions" (starts with xoxb-).
SLACK_BOT_TOKEN=
# The bot user's member ID (starts with U). Found in Slack app settings.
SLACK_BOT_USER_ID=
# Your Slack workspace's team ID (starts with T).
SLACK_TEAM_ID=
# The Slack user ID of the single owner who can talk to the bot.
SYM_OWNER_SLACK_USER_ID=

# ── Fireworks (LLM) ───────────────────────────────────────────────────────────
# API key from fireworks.ai.
FIREWORKS_API_KEY=
# Model to use, e.g. accounts/fireworks/models/llama-v3p1-405b-instruct
FIREWORKS_MODEL=
# Optional: override the Fireworks base URL (default: https://api.fireworks.ai/inference/v1)
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ── Agent server ──────────────────────────────────────────────────────────────
# Optional: port for the Hono server (default: 3001)
# AGENT_PORT=3001

# ── Behavior controls ─────────────────────────────────────────────────────────
# These knobs change how Sym behaves at runtime without touching code.
# All are optional — safe defaults are used when unset.

# Minimum number of tool calls before the live task card appears in the thread.
# Slash commands always show from tool #1 regardless of this value.
# Set to 0 to disable the task card entirely.
# Default: 3
# TASK_CARD_THRESHOLD=3

# What happens to the task card once the reply is delivered.
#   delete   — card is removed from the thread (default, keeps things clean)
#   collapse — card shrinks to a single "✅ N steps · Xs" summary line
# Default: delete
# TASK_CARD_AFTER=delete
