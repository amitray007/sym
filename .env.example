# Sym environment — copy to .env and fill in values. NEVER commit .env.

# ── Slack ─────────────────────────────────────────────────────────────────────
# From your Slack app's "Basic Information" page.
SLACK_SIGNING_SECRET=
# Bot token from "OAuth & Permissions" (starts with xoxb-).
SLACK_BOT_TOKEN=
# The bot user's member ID (starts with U). Found in Slack app settings.
SLACK_BOT_USER_ID=
# Your Slack workspace's team ID (starts with T).
SLACK_TEAM_ID=
# The Slack user ID of the single owner who can talk to the bot.
SYM_OWNER_SLACK_USER_ID=

# Optional — owner's User OAuth token (starts with xoxp-). When set, tools
# declared `actor: 'user'` (search_messages, read_channel, read_thread,
# read_user_profile, list_channels, plus Phase-B act-as-owner writes) call
# Slack APIs AS the owner instead of as the bot — unlocking:
#   • Real workspace search via search.messages (search:read scope)
#   • Private channels + DMs the owner is in without bot membership
#   • Setting the owner's status / reminders / posting as the owner (Phase B)
#
# Issued by reinstalling the Slack app once user scopes are added. Treat as a
# production secret — leak == full Slack identity compromise.
# SLACK_OWNER_USER_TOKEN=

# ── Fireworks (LLM) ───────────────────────────────────────────────────────────
# API key from fireworks.ai.
FIREWORKS_API_KEY=
# Model to use, e.g. accounts/fireworks/models/llama-v3p1-405b-instruct
FIREWORKS_MODEL=
# Optional: override the Fireworks base URL (default: https://api.fireworks.ai/inference/v1)
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ── Agent server ──────────────────────────────────────────────────────────────
# Optional: port for the Hono server (default: 3001)
# AGENT_PORT=3001

# ── Behavior controls ─────────────────────────────────────────────────────────
# These knobs change how Sym behaves at runtime without touching code.
# All are optional — safe defaults are used when unset.

# Minimum number of tool calls before the live task card appears in the thread.
# Slash commands always show from tool #1 regardless of this value.
# Set to 0 to disable the task card entirely.
#
# Default: 1 — task cards render INSIDE the streaming reply (native task_update
# chunks), not as a separate message, so there's no clutter cost to showing
# them from the first tool. Raise to 2+ if you want single-tool replies to
# stay card-free.
# TASK_CARD_THRESHOLD=1

# What happens to the task card once the reply is delivered.
#   delete   — card is removed from the thread (default, keeps things clean)
#   collapse — card shrinks to a single "✅ N steps · Xs" summary line
# Default: delete
# TASK_CARD_AFTER=delete

# When `true` (default), post_as_owner appends a small `_(via Sym)_` footer to
# the relayed message so collaborators know the owner used an assistant.
# Set to `false` to suppress the marker.
# OWNER_POST_MARKER=true

# ── MCP / connectors ──────────────────────────────────────────────────────────
# Variables for the MCP connector pool. All optional — Sym runs without any
# connectors when none are configured.

# Path to the connector config file (written by `sym add`).
# Default: .sym/config.json (in the current working directory).
# SYM_CONFIG_PATH=.sym/config.json

# Legacy inline connector definition (JSON array). Superseded by SYM_CONFIG_PATH
# when that file exists. For quick one-off testing only.
# SYM_MCP_SERVERS=[{"name":"my-server","type":"stdio","cmd":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}]

# 32-byte AES-256-GCM key for the encrypted credential store (base64 or hex).
# Required only when using OAuth connectors. Generate once with:
#   node -e "import('node:crypto').then(m=>process.stdout.write(m.randomBytes(32).toString('base64')))" --input-type=module
# Keep this secret — it protects all stored OAuth tokens.
# SYM_ENCRYPTION_KEY=

# Path to the encrypted SQLite credential database.
# Default: .sym/credentials.db (in the current working directory).
# In production (Docker), bind-mount a persistent volume and set this to
# e.g. /data/credentials.db.
# SYM_DB_PATH=.sym/credentials.db

# Public HTTPS base URL of this agent — required for OAuth connector callbacks.
# Example: https://agent.yourdomain.com
# Without this, OAuth connectors' redirect_uri falls back to 127.0.0.1 (local dev only).
# SYM_PUBLIC_URL=

# Maximum time (ms) to wait for a connector's connect + listTools on startup.
# Default: 10000 (10 s). Increase for slow or remote MCP servers.
# SYM_MCP_CONNECT_TIMEOUT_MS=10000

# ── Operator / CLI ────────────────────────────────────────────────────────────
# Variables that control the run_cli tool and the admin HTTP surface.

# Comma-separated list of CLI binaries the agent may execute via run_cli.
# Use `*` to allow any binary on PATH. Defaults to: sym,gog,gcloud,gsutil,bq,sentry-cli,gh,jq
# SYM_CLI_ALLOWLIST=sym,gog,gcloud,gsutil,bq,sentry-cli,gh,jq

# Set to `true` (or 1/yes/on) to require owner confirmation before run_cli
# executes any non-introspection command. Default: false (full freedom within
# the allowlist). Managed automatically by `sym cli confirm on/off`.
# SYM_CLI_CONFIRM=false

# Override the admin HTTP base URL used by the `sym` CLI to reach the running
# agent (POST /admin/reload, GET /admin/status).
# Default: http://127.0.0.1:<AGENT_PORT> — only set for non-loopback deploys.
# SYM_ADMIN_URL=
