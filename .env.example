# Copy to .env.local for `eve dev`. Never commit real values.
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DATABASE_URL=postgres://sym:sym@localhost:55432/sym
SYM_PACK_DIR=./pack
SYM_MCP_TOKEN=
# Milestone 1 only. `pnpm t3:login <mcp-url>` fills these. Later the token lives in Postgres.
T3_MCP_URL=
T3_TOKEN=
# Slack user IDs allowed to use Sym, comma-separated. Milestone 1: the owner only.
SYM_SLACK_USERS=
