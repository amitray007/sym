# Sym environment — copy to .env and fill in. NEVER commit .env.
# Dokploy injects these in production.

# --- Postgres (Sp2 @sym/db) ---
# Local native install. Create the dev DB once: `createdb sym_dev`
DATABASE_URL=postgres://localhost:5432/sym_dev

# --- Redis (used from S1 onward: event dedup, locks, OAuth state TTL) ---
REDIS_URL=redis://localhost:6379

# --- Secrets (Sp4 @sym/secrets) ---
# 32-byte base64 key for libsodium secretbox. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Loss = irrecoverable corruption of every encrypted token. Handle off-disk.
# Not required at the Sp2 commit (encryptedText is passthrough until Sp4).
SYM_ENCRYPTION_KEY=

# --- Node ---
NODE_ENV=development
