# Copy to .env.local for `eve dev`. Never commit real values.
# Brain model through the Vercel AI Gateway. SYM_MODEL takes any gateway model ID.
AI_GATEWAY_API_KEY=
SYM_MODEL=anthropic/claude-sonnet-5.5
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DATABASE_URL=postgres://sym:sym@localhost:55432/sym
SYM_PACK_DIR=./pack
SYM_MCP_TOKEN=
# Base URL the owner's browser returns to after the worker sign-in. Must be https unless it is
# loopback, such as Sym's public HTTPS address. Defaults to SYM_CALLBACK_URL.
SYM_SIGNIN_URL=
# Fallback only: `pnpm t3:login <mcp-url>` fills these. Deployed Sym stores the sign-in in Postgres
# after the owner asks Sym to "sign in to the worker" (decision 036).
T3_MCP_URL=
T3_TOKEN=
T3_TOKEN_EXPIRES_AT=
# Optional. Overrides the default worker model, as <provider>/<model> from `pnpm t3:check`. It
# joins the worker model list when missing. Without it, the pack's default or the built-in
# default applies.
SYM_WORKER_MODEL=
# T3 project titles or IDs Sym may work on, comma-separated. Required without a pack: with
# neither this nor a pack, no job starts (decision 042).
SYM_PROJECTS=
# Optional. The name Slack users see for the worker. Default: Worker (decision 043).
SYM_WORKER_LABEL=
# Slack user IDs allowed to use Sym, comma-separated. Milestone 1: the owner only.
SYM_SLACK_USERS=
# Bearer for scripts, CI, and operators calling /eve/v1/session. Unset blocks them in production.
SYM_API_TOKEN=
# Daily digest: a channel ID, or the owner's user ID for a DM. Unset means no digest.
SYM_DIGEST_CHANNEL=
SYM_DIGEST_CRON=0 17 * * *
# Base URL the worker uses to call Sym back. Without it, jobs wait for the 4-minute poll.
SYM_CALLBACK_URL=
# The owner's Slack user ID, for sign-in notices and DMs when no pack is loaded.
SYM_OWNER_SLACK_USER=
