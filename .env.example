# Copy to .env.local for `eve dev`. Never commit real values.
# Brain model through the Vercel AI Gateway. SYM_MODEL takes any gateway model ID.
AI_GATEWAY_API_KEY=
SYM_MODEL=anthropic/claude-sonnet-5.5
# Optional. Overrides the reasoning level. Use provider-default for a model without reasoning.
SYM_REASONING=
# Optional. The database `pnpm eval` uses instead of DATABASE_URL. Default: sym_eval on the local Postgres.
SYM_EVAL_DATABASE_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DATABASE_URL=postgres://sym:sym@localhost:55432/sym
SYM_PACK_DIR=./pack
SYM_MCP_TOKEN=
# Base URL the owner's browser returns to after the worker sign-in. Must be https unless it is
# loopback, such as Sym's public HTTPS address. Defaults to SYM_CALLBACK_URL.
SYM_SIGNIN_URL=
# Fallback only: `pnpm t3:login <mcp-url>` fills these. Deployed Sym stores the sign-in in Postgres
# after the owner asks Sym to "sign in to the worker" (decision 036).
T3_MCP_URL=
T3_TOKEN=
T3_TOKEN_EXPIRES_AT=
# MCP connections the owner adds from Slack (decision 045). A server that needs a token reads
# SYM_MCP_<NAME>_TOKEN, for example SYM_MCP_EXAMPLE_TRACKER_TOKEN for `example-tracker`. Sym says
# the exact name. It reads no other variable for a connection.
# SYM_MCP_EXAMPLE_TRACKER_TOKEN=
# Optional. Overrides the default worker model, as <provider>/<model> from `pnpm t3:check`. It
# joins the worker model list when missing. Without it, the pack's default or the built-in
# default applies.
SYM_WORKER_MODEL=
# Optional. The brain's voice: plain, casual, or spicy. Default casual. A pack persona wins.
SYM_PERSONA=
# Optional. on (default) or off: the helpful / not helpful buttons under replies.
SYM_FEEDBACK=
# Optional. Clean runs in a row before Sym suggests trusting a playbook. Default 5, at least 2.
SYM_TRUST_RUNS=
# T3 project titles or IDs Sym may work on, comma-separated. Required without a pack: with
# neither this nor a pack, no job starts (decision 042).
SYM_PROJECTS=
# Optional. The name Slack users see for the worker. Default: Worker (decision 043).
SYM_WORKER_LABEL=
# Slack user IDs allowed to use Sym, comma-separated. Milestone 1: the owner only.
SYM_SLACK_USERS=
# Optional. on (default) or off: a private line that tells someone off the allow-list to ask the owner.
SYM_STRANGER_REPLIES=
# The name people say for Sym in a thread with several people, without a tag. Default: sym.
SYM_BOT_NAME=
# Bearer for scripts, CI, and operators calling /eve/v1/session. Unset blocks them in production.
SYM_API_TOKEN=
# Daily digest: a channel ID, or the owner's user ID for a DM. Unset means no digest. The weekly
# learn proposals use the same channel.
SYM_DIGEST_CHANNEL=
# Optional. off (default) or on. On posts the daily digest to SYM_DIGEST_CHANNEL (decision 054).
SYM_DIGEST=
# Optional. off (default) or on. On runs the verifier, a paid model call, on each finished code job.
SYM_VERIFIER=
# Optional. off (default) or on. On moves each started job into its own Slack code channel
# (decision 067). The app needs the code channel scopes in slack/manifest.yaml.
SYM_CODE_CHANNELS=
# Optional. on (default) or off. On has the writer subagent, a model call, write each finished
# code job's result in the persona's voice. Off keeps the template (decision 062).
SYM_RESULT_WRITER=
# Optional. off (default) or on. On follows each job's PR for 7 days and posts CI and review wakes.
SYM_PR_FOLLOW=
SYM_DIGEST_CRON=0 17 * * *
# Base URL the worker uses to call Sym back. Without it, jobs wait for the 4-minute poll.
SYM_CALLBACK_URL=
# The owner's Slack user ID, for sign-in notices and DMs when no pack is loaded.
SYM_OWNER_SLACK_USER=
