# Sym environment — copy to .env and fill in values. NEVER commit .env.
# Dokploy injects these as secrets in production.
# Run `sh scripts/dev-setup.sh` to generate .env automatically for local dev.

# ── Node ──────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Postgres (Sp2 · @sym/db) ─────────────────────────────────────────────────
# REQUIRED for all packages.
# Local native install — create the dev DB once: `createdb sym_dev`
# If using docker-compose.yml instead, set: postgres://sym:sym@localhost:5434/sym_dev
DATABASE_URL=postgres://localhost:5432/sym_dev

# ── Redis (S1 onward: event dedup, turn locks, OAuth state TTL, MCP sessions) ─
# REQUIRED from S1 onward.
# Local native install.
# If using docker-compose.yml instead, set: redis://localhost:6380
REDIS_URL=redis://localhost:6379

# ── Secrets (Sp4 · @sym/secrets) ─────────────────────────────────────────────
# REQUIRED. 32-byte random key encoded as base64, used for libsodium secretbox.
# Generate with:
#   pnpm --filter @sym/secrets gen-key
# Or let scripts/dev-setup.sh generate one automatically.
#
# Loss of this key = irrecoverable corruption of every encrypted token in DB.
# Store off-disk (password manager / Dokploy secret). Never version-control it.
#
# Key rotation: add retired keys as a comma-separated list so old ciphertexts
# can still be decrypted during a dual-key migration window:
#   SYM_ENCRYPTION_KEYS_RETIRED=<oldKeyB64>,<olderKeyB64>
SYM_ENCRYPTION_KEY=
# SYM_ENCRYPTION_KEYS_RETIRED=

# ── Slack (S1 · @sym/adapter-slack) ──────────────────────────────────────────
# Required once S1 lands. Set in Dokploy secrets for production.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_APP_TOKEN=          # for Socket Mode (optional — depends on infra choice)
# SLACK_BOT_TOKEN=          # set per-workspace in DB; this is the default/fallback

# ── Clerk (S3 · apps/dashboard) ──────────────────────────────────────────────
# Required once apps/dashboard lands. Set in Dokploy secrets for production.
# Google + Slack OAuth providers only (see Decision D1 in implementation-ideology-plan.md).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# ── Fireworks (S2 · @sym/provider-fireworks) ──────────────────────────────────
# Required once S2 lands. Encrypted at rest in provider_configs table via @sym/secrets.
# FIREWORKS_API_KEY=

# ── Sandbox (S6 · @sym/sandbox) ──────────────────────────────────────────────
# JWT secret for signing ephemeral sandbox identity tokens.
# Required once S6 lands.
# SANDBOX_JWT_SECRET=

# ── Dashboard app (S3 · apps/dashboard) ───────────────────────────────────────
# Public URL for the Dashboard, used in OAuth redirect URIs and Dokploy smoke test.
# DASHBOARD_URL=https://dashboard.example.com

# ── Agent app (S2 · apps/agent) ───────────────────────────────────────────────
# Public URL for the Agent (Hono), used in Dokploy smoke test and egress proxy config.
# AGENT_URL=https://agent.example.com
